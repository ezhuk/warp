load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "warp_bin",
    srcs = ["main.cpp"],
    deps = [
        ":warp",
        "@fmt",
    ],
)

cc_library(
    name = "warp",
    srcs = [
        "server.cpp",
        "warp.cpp",
    ],
    hdrs = [
        "server.h",
        "warp.h",
    ],
    include_prefix = "warp",
    deps = [
        "//warp/http",
        "//warp/mqtt:client",
        "//warp/mqtt:server",
        "//warp/utils:signal",
    ],
)
