load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "app",
    srcs = ["main.cpp"],
    deps = [
        ":server",
        ":warp",
        "@folly//folly/init",
        "@folly//folly/logging",
        "@folly//folly/logging:init",
        "@folly//folly/portability:gflags",
    ],
)

cc_library(
    name = "scoped_event_base",
    hdrs = ["scoped_event_base.h"],
    include_prefix = "warp",
    deps = [
        "@folly//folly/io/async:async_base",
        "@folly//folly/io/async:async_signal_handler",
    ],
)

cc_library(
    name = "server",
    srcs = ["server.cpp"],
    hdrs = ["server.h"],
    include_prefix = "warp",
    deps = [
        ":scoped_event_base",
        "@folly//folly:unit",
        "@folly//folly/futures:core",
        "@folly//folly/io:iobuf",
        "@wangle//wangle/bootstrap:server_bootstrap",
        "@wangle//wangle/channel:async_socket_handler",
        "@wangle//wangle/channel:event_base_handler",
        "@wangle//wangle/channel:handler",
        "@wangle//wangle/channel:pipeline",
        "@wangle//wangle/service",
        "@wangle//wangle/service:server_dispatcher",
    ],
)

cc_library(
    name = "warp",
    srcs = [],
    hdrs = [],
    defines = ['WARP_VERSION=\\"{}\\"'.format(module_version())],
    include_prefix = "warp",
    deps = [],
)
