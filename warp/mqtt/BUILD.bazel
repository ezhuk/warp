load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "client",
    srcs = ["client.cpp"],
    hdrs = ["client.h"],
    include_prefix = "warp/mqtt",
    deps = [
        ":codec",
        "@folly//folly/executors:io_thread_pool_executor",
        "@folly//folly/futures:core",
        "@wangle//wangle/bootstrap:client_bootstrap",
        "@wangle//wangle/channel:async_socket_handler",
        "@wangle//wangle/channel:event_base_handler",
        "@wangle//wangle/channel:pipeline",
        "@wangle//wangle/service:client_dispatcher",
    ],
)

cc_library(
    name = "codec",
    srcs = [
        "codec.cpp",
        "message.cpp",
    ],
    hdrs = [
        "codec.h",
        "message.h",
    ],
    include_prefix = "warp/mqtt",
    deps = [
        "@folly//folly:varint",
        "@folly//folly/io:iobuf",
    ],
)

cc_library(
    name = "server",
    srcs = ["server.cpp"],
    hdrs = ["server.h"],
    include_prefix = "warp/mqtt",
    deps = [
        ":codec",
        "//warp/websocket",
        "@folly//folly/executors:cpu_thread_pool_executor",
        "@folly//folly/io/async:async_base",
        "@folly//folly/system:hardware_concurrency",
        "@proxygen//proxygen/httpserver:httpserver_headers",
        "@wangle//wangle/bootstrap:server_bootstrap",
        "@wangle//wangle/channel:async_socket_handler",
        "@wangle//wangle/channel:event_base_handler",
        "@wangle//wangle/channel:pipeline",
        "@wangle//wangle/service:executor_filter",
        "@wangle//wangle/service:server_dispatcher",
    ],
)
